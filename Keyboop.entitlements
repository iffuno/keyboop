<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- НЕ sandbox (menu-bar утилита, нужен глобальный доступ к клавиатуре/раскладке). -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Доступ к микрофону: без этого macOS отдаёт inputNode с ТИШИНОЙ (нули, RMS=0),
         даже если NSMicrophoneUsageDescription есть. Критично для голосового набора. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>
</dict>
</plist>
